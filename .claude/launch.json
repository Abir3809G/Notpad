{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs');const path=require('path');let p=req.url==='/'?'/index.html':req.url;let fp=path.join(process.cwd(),decodeURIComponent(p.split('?')[0]));fs.readFile(fp,(err,data)=>{if(err){res.writeHead(404);res.end('not found');return;}res.writeHead(200);res.end(data);});}).listen(5173);console.log('listening on 5173');"],
      "port": 5173
    }
  ]
}
